# Copy this file to .env and fill in your values.

# --- LLM configuration ---
# Provider: "gemini" (recommended) or "none" (always use deterministic fallback)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
# gemini-3.6-flash is the current recommended default (good quality/cost for
# narrative synthesis). gemini-2.5-flash or gemini-2.5-flash-lite also work
# if you prefer the cheaper, longer-established family.
GEMINI_MODEL=gemini-3.6-flash
LLM_MAX_TOKENS=1000
LLM_TIMEOUT_SECONDS=20

# --- ML / Analysis configuration ---
ANOMALY_CONTAMINATION=0.05
FORECAST_PERIODS_DAYS=30

# --- RAG configuration ---
RAG_TOP_K=3

# --- API configuration ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Logging ---
LOG_LEVEL=INFO
